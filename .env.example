# API Endpoints
# -------------

# Protocol and host for MyETM. No trailing slash please.
NEXT_PUBLIC_MYETM_URL=http://localhost:3002

# Protocol and host for ETModel. No trailing slash please.
NEXT_PUBLIC_ETMODEL_URL=http://localhost:3001

# Protocol and host for ETENGINE. No trailing slash please.
NEXT_PUBLIC_ETENGINE_URL=http://localhost:3000

# Server-side base URLs the API routes prefer when collections shares an internal Docker network
# with ETEngine and ETModel, so it can reach them over the internal network instead of the public
# host. No NEXT_PUBLIC_ prefix: they are read at runtime on the server and never reach the browser.
# Leave empty outside that setup. No trailing slash please.
ETENGINE_INTERNAL_URL=
ETMODEL_INTERNAL_URL=

# Shared session
# --------------

# Appended to the session cookie names MyETM writes, so deployments sharing a cookie domain do not
# share a session (beta uses "_beta"). Must match the SSO_COOKIE_SUFFIX given to MyETM, ETEngine
# and ETModel in the same environment, and must be set at build time — Next.js inlines it.
NEXT_PUBLIC_SSO_COOKIE_SUFFIX=
